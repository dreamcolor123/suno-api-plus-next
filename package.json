{
  "name": "suno-api-plus-next",
  "description": "Enhanced Suno API with admin dashboard, multi-account pool, OpenAI-compatible auth, YesCaptcha/2Captcha, and cookie tools.",
  "author": {
    "name": "gcui.ai",
    "url": "https://github.com/gcui-art/"
  },
