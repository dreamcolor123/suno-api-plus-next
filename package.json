    "ghost-cursor-playwright": "^2.1.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.468.0",
    "next": "14.1.4",
    "next-swagger-doc": "^0.4.0",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9.0.1",
