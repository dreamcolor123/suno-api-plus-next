  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:workspace": "next start -p 3010",
    "lint": "next lint",
    "test": "node --test tests/*.test.mjs",
    "test:voice": "node --test tests/voice-contract.test.mjs",
    "test:fast-upload": "node --test tests/fast-upload-contract.test.mjs",
    "test:clip-metadata": "node --test tests/clip-metadata-contract.test.mjs",
    "test:advanced-stems": "node --test tests/advanced-stems-contract.test.mjs",
    "test:openapi": "node --test tests/openapi-contract.test.mjs",
    "test:python": "python -m pytest -q tests",
    "typecheck": "tsc --noEmit --pretty false",
    "get-cookie": "node suno-cookie-extractor/get-cookie.mjs",
    "verify-cookie": "node suno-cookie-extractor/verify-cookie.mjs"
  },
  "dependencies": {
    "@2captcha/captcha-solver": "^1.3.0",
